[user]
	email = Blue.Yuan@morningstar.com
	name = Yijun "Blue" Yuan
[github]
	user = bbbush
[alias]
  k = "!_() { gitk \"$@\"; }; _"
  pr = "!_() { \
	git pull --no-rebase origin refs/pull-requests/\"$1\"/from; \
  }; _"
  fetch-pr ="!_() {\
	git fetch origin refs/pull-requests/\"$1\"/from; \
  }; _"
[credential "https://msstash.morningstar.com"]
	provider = bitbucket
[credential]
	helper =
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
	useHttpPath = true
[blame]
	ignoreRevsFile = :(optional).git-blame-ignore-revs
