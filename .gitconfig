[user]
	email = bbbush.yuan@gmail.com
	name = Yijun Blue Yuan
[color]
	ui = auto
[github]
	user = bbbush
[push]
	default = simple
[credential]
	helper = libsecret
[alias]
	k = "!_() { gitk \"$@\"; }; _"
[commit]
	verbose = true
[includeIf "gitdir:~/Worktrees/GitHub/"]
        path = ~/.gitconfig-github
