[user]
	email = bbbush.yuan@gmail.com
	name = Yijun Blue Yuan
[color]
	ui = auto
[github]
	user = bbbush
[push]
	default = simple
[credential]
	helper = libsecret
[alias]
	k = "!_() { gitk \"$@\"; }; _"
[commit]
	verbose = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[includeIf "gitdir:~/Worktrees/GitHub/"]
        path = ~/.gitconfig-github
